{
  "name": "workspace",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "bierner.markdown-mermaid"
      ],
      "settings": {
        "chat.agent.enabled": true,
        "chat.tools.global.autoApprove": true,
        "chat.agent.maxRequests": 1000
      }
    }
  },
  "runArgs": [
    "--sysctl",
    "net.ipv6.conf.all.disable_ipv6=1",
    "--sysctl",
    "net.ipv6.conf.default.disable_ipv6=1",
    "--dns",
    "1.1.1.1",
    "--dns",
    "8.8.8.8"
  ],
  "forwardPorts": [8080],
  "postCreateCommand": "sudo chown vscode:vscode /home/vscode/.cache/ms-playwright && curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh",
  "mounts": [
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/vscode/.gitconfig,type=bind,readonly",
    "source=${localEnv:HOME}/.secrets,target=/home/vscode/.secrets,type=bind,readonly",
    "source=${localEnv:HOME}/.android,target=/home/vscode/.android,type=bind,consistency=cached",
    "source=workplace-playwright-cache,target=/home/vscode/.cache/ms-playwright,type=volume"
  ]
}
